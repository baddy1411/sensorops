# Copy to .env and fill in real values

# DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...

# LLM model override (default: deepseek-chat = DeepSeek-V3)
# Other options: deepseek-reasoner (R1, slower but stronger reasoning)
SENSOROPS_LLM_MODEL=deepseek-chat

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=data/chroma

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Kafka (optional — only needed for Kafka mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sensorops.raw

# Postgres / pgvector (optional — only needed if using pgvector RAG backend)
POSTGRES_DSN=postgresql://sensorops:sensorops@localhost:5432/sensorops

# OpenLineage
OPENLINEAGE_URL=http://localhost:5001
OPENLINEAGE_NAMESPACE=sensorops
